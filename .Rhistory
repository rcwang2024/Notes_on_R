knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE)
# AND
TRUE & FALSE
# OR
TRUE | FALSE
# NOT
!TRUE
# Element-wise AND
c(TRUE, FALSE, TRUE) & c(TRUE, TRUE, FALSE)
# Element-wise OR
c(TRUE, FALSE, TRUE) | c(TRUE, TRUE, FALSE)
# Short-circuit AND (only evaluates second if first is TRUE)
TRUE && FALSE
# Short-circuit OR (only evaluates second if first is FALSE)
TRUE || FALSE
knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE)
# Create sample data
df <- data.frame(
id = 1:10,
name = paste0("Sample_", 1:10),
value = c(23, 45, 67, 12, 89, 34, 56, 78, 90, 23),
group = rep(c("A", "B"), each = 5)
)
# Subset rows
df[df$value > 50, ]
df[df$group == "A", ]
df[df$value > 30 & df$group == "B", ]
# Subset columns
df[, c("name", "value")]
df[c("name", "value")]
# Subset function
subset(df, value > 50)
subset(df, value > 50, select = c(name, value))
subset(df, group == "A", select = -id)
# Order/sort
df[order(df$value), ]
df[order(-df$value), ]  # Descending
df[order(df$group, -df$value), ]  # Multiple columns
# Create sample data
df <- data.frame(
id = 1:10,
name = paste0("Sample_", 1:10),
value = c(23, 45, 67, 12, 89, 34, 56, 78, 90, 23),
group = rep(c("A", "B"), each = 5)
)
# Subset rows
df[df$value > 50, ]
df[df$group == "A", ]
df[df$value > 30 & df$group == "B", ]
# Subset columns
df[, c("name", "value")]
df[c("name", "value")]
# Subset function
subset(df, value > 50)
subset(df, value > 50, select = c(name, value))
subset(df, group == "A", select = -id)
# Order/sort
df[order(df$value), ]
df[order(-df$value), ]  # Descending
df[order(df$group, -df$value), ]  # Multiple columns
knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE, eval = FALSE)
# .N - number of rows
dt[, .N]
knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE, eval = FALSE)
library(data.table)
library(dplyr)
library(microbenchmark)
# Create data.table
dt <- data.table(
id = 1:1000000,
group = sample(LETTERS[1:5], 1000000, replace = TRUE),
value = rnorm(1000000),
date = sample(seq(as.Date("2020-01-01"), as.Date("2023-12-31"), by = "day"),
1000000, replace = TRUE)
)
# Basic operations
# Filter rows (i)
dt[value > 0]
dt[group %in% c("A", "B")]
# Select columns (j)
dt[, .(id, value)]
dt[, list(id, value)]  # Same as above
# Compute in j
dt[, mean(value)]
dt[, .(mean_val = mean(value), sd_val = sd(value))]
# Group by (by)
dt[, .(mean_val = mean(value)), by = group]
dt[, .(mean_val = mean(value), count = .N), by = .(group, year = year(date))]
# Combine all three
dt[value > 0, .(mean_val = mean(value), .N), by = group]
# .N - number of rows
dt[, .N]
dt[, .N, by = group]
# .SD - Subset of Data (current group)
dt[, lapply(.SD, mean), by = group, .SDcols = c("value")]
# .SDcols - specify columns for .SD
dt[, lapply(.SD, mean), by = group, .SDcols = is.numeric]
# .I - row numbers
dt[, .I[value == max(value)], by = group]
# .GRP - group counter
dt[, group_id := .GRP, by = group]
# .BY - current group values
dt[, .(group_name = .BY[[1]], mean = mean(value)), by = group]
# Add column
dt[, new_col := value * 2]
# Multiple columns
dt[, `:=`(
col1 = value + 1,
col2 = value - 1,
col3 = value^2
)]
# Conditional update
dt[group == "A", value := value * 1.1]
# Delete column
dt[, new_col := NULL]
# Update by group
dt[, value_centered := value - mean(value), by = group]
# Functional form
cols <- c("col1", "col2")
dt[, (cols) := NULL]
# Rolling joins
dt1 <- data.table(id = c(1, 2, 3), val = c(10, 20, 30), key = "id")
dt2 <- data.table(id = c(1.5, 2.5, 3.5), val = c(100, 200, 300))
# Roll forward
dt2[dt1, roll = TRUE]
# Add column
dt[, new_col := value * 2]
# Multiple columns
dt[, `:=`(
col1 = value + 1,
col2 = value - 1,
col3 = value^2
)]
# Conditional update
dt[group == "A", value := value * 1.1]
# Delete column
dt[, new_col := NULL]
# Update by group
dt[, value_centered := value - mean(value), by = group]
# Functional form
cols <- c("col1", "col2")
dt[, (cols) := NULL]
# Rolling joins
dt1 <- data.table(id = c(1, 2, 3), val = c(10, 20, 30), key = "id")
dt2 <- data.table(id = c(1.5, 2.5, 3.5), val = c(100, 200, 300))
# Roll forward
dt2[dt1, roll = TRUE]
# Roll backward
dt2[dt1, roll = -Inf]
